{
  "name": "obs-apresenta-vc",
  "version": "0.2.0",
  "private": true,
  "description": "ApresentaVC — estúdio local de notícias com OBS, React e MySQL",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --config vite.local.config.ts",
    "build": "vite build --config vite.local.config.ts",
    "build:local": "vite build --config vite.local.config.ts",
    "start": "node local/server.mjs",
    "start:local": "node local/server.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "test": "node --test tests/*.test.mjs local/test-editions.mjs local/test-mysql.mjs local/test-hud.mjs local/test-http.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mantine/core": "^8.3.0",
    "@mantine/hooks": "^8.3.0",
    "@mantine/notifications": "^8.3.0",
    "mysql2": "^3.24.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "^8.3.5"
  }
}
